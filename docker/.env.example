# Copier en .env et remplir les valeurs

# --- PostgreSQL (local, remplace le RDB managé Scaleway) ---
POSTGRES_DB=nextcloud_db
POSTGRES_USER=nextcloud_user
POSTGRES_PASSWORD=change-me-db-password

# --- Nextcloud ---
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=change-me-admin-password
# Domaines séparés par des espaces, ex. en local : "localhost 127.0.0.1"
NEXTCLOUD_TRUSTED_DOMAINS=localhost

# --- Nginx ---
# Port HTTP d'entrée. En local : 8080 pour éviter les conflits.
WEB_PORT=8080

# --- S3 Scaleway (rempli à l'étape migration, pas nécessaire au premier test) ---
# S3_BUCKET=nextcloud
# S3_HOSTNAME=s3.fr-par.scw.cloud
# S3_REGION=fr-par
# S3_KEY=
# S3_SECRET=
