# Scaleway Provider Configuration
scw_region = "fr-par"
scw_zone   = "fr-par-1"

# Instance Configuration
instance_type    = "Start1-S"
root_volume_size = 50

# SSH Configuration
ssh_public_key = "ssh-rsa AAAAB3NzaC1yc2EAAAADAQABAAABAQ..."

# Domain Configuration
domain_name = "nextcloud.yourdomain.com"

# Database Configuration
db_instance_type = "PLAY2-NANO"
db_volume_size   = 20
db_name          = "nextcloud_db"
db_user          = "nextcloud_user"

# S3 Bucket Configuration
s3_bucket_name = "nextcloud-files-bucket-unique-name"

# Nextcloud Admin Configuration
nextcloud_admin_user = "admin"

# SSL Configuration
ssl_email = "admin@yourdomain.com"

# Scaleway Credentials (use environment variables or GitHub Secrets)
# scw_access_key = "your-scaleway-access-key"
# scw_secret_key = "your-scaleway-secret-key"
