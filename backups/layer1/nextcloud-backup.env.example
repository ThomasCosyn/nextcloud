# Nextcloud daily backup (Layer 1) - configuration
# Copy this file to /etc/nextcloud-backup/nextcloud-backup.env and fill it in.
# Permissions MUST be 0600, root only (it contains DB + S3 credentials).

# --- PostgreSQL (from terraform output database_host + your db_* variables) ---
BACKUP_DB_HOST=""        # e.g. 1a2b3c4d-xxxx-yyyy-zzzz.db.<region>.rdb.scw.cloud
BACKUP_DB_PORT="5432"
BACKUP_DB_NAME="nextcloud_db"
BACKUP_DB_USER="nextcloud_user"
BACKUP_DB_PASSWORD=""

# --- Nextcloud install path on the instance ---
BACKUP_NEXTCLOUD_DIR="/var/www/nextcloud"

# --- rclone remotes (defined in /root/.config/rclone/rclone.conf) ---
# Source: the PRIMARY S3 bucket currently used by Nextcloud (Scaleway project A)
BACKUP_RCLONE_SRC="scaleway-src:your-primary-bucket-name"
# Destination: the SECOND S3 bucket created BY HAND in a SEPARATE Scaleway
# project (project B), OUTSIDE Terraform.
BACKUP_RCLONE_DST="scaleway-backup:nextcloud-backup"

# --- retention (days kept locally on the instance) ---
BACKUP_RETENTION_DAYS="14"

# --- optional: local working directory for dumps (default /var/backups/nextcloud) ---
# BACKUP_LOCAL_DIR="/var/backups/nextcloud"
